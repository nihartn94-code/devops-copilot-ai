# ==============================================================================
# DevOps Copilot AI - Environment Configuration Example
# Copy this file to .env and configure your local settings.
# NOTE: Never commit your actual .env file or AWS secrets to Git!
# ==============================================================================

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP (Model Context Protocol) Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ENDPOINT=/sse

# Amazon Bedrock Settings
# If AWS credentials are blank or invalid, DevOps Copilot runs in a transparent
# "Demo Mode" with deterministic offline responses clearly labeled as fallbacks.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Supported Bedrock model IDs:
# - anthropic.claude-3-5-sonnet-20241022-v2:0
# - anthropic.claude-3-haiku-20240307-v1:0
# - amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Force Demo Fallback Mode even if AWS credentials exist (useful for testing/demos)
# Values: auto | force_demo | force_bedrock
BEDROCK_MODE=auto

# Security & Repository Access Configuration
# Comma-separated list of absolute directory paths authorized for read-only inspection.
# Leave blank to allow any directory within the current project/workspace.
AUTHORIZED_REPO_ROOTS=

# Limits
MAX_UPLOAD_SIZE_MB=5
MAX_LOG_LINES=5000
SUBPROCESS_TIMEOUT_SECONDS=15
